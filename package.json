{
  "name": "nai-agent",
  "private": true,
  "version": "0.1.0",
  "description": "Nai Agent - Desktop AI Agent Workspace",
  "main": "electron/main.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "wait-on file:.vite-port --timeout 30000 && electron --js-flags=\"--max-old-space-size=4096\" .",
    "dev": "concurrently -k -n \"VITE,ELECTRON\" -c \"blue,green\" \"npm run dev:vite\" \"npm run dev:electron\"",
    "build:vite": "vite build",
    "build": "npm run build:vite",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:all": "npm run build && electron-builder -mwl",
    "preview": "vite preview"
  },
  "build": {
    "appId": "com.naiagent.app",
    "productName": "Nai Agent",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icono.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Nai Agent"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "public/icono.ico",
      "category": "public.app-category.productivity",
      "identity": null
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/icono.ico",
      "category": "Utility"
    }
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "lucide-react": "^1.16.0",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-resizable-panels": "^4.12.3",
    "wavefile": "^11.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "electron": "^34.5.8",
    "electron-builder": "^26.15.3",
    "tailwindcss": "^4.0.9",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  }
}
